<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartisanUi.Catalog" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/smartisan_catalog_settings_background</item>
        <item name="android:colorBackground">@color/smartisan_catalog_page_background</item>
        <item name="android:statusBarColor">@color/smartisan_catalog_system_bar</item>
        <item name="android:navigationBarColor">@color/smartisan_catalog_page_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="smartisanCheckBoxStyle">@style/Widget.SmartisanUi.CheckBox</item>
        <item name="smartisanRadioButtonStyle">@style/Widget.SmartisanUi.RadioButton</item>
        <item name="smartisanProgressBarStyle">@style/Widget.SmartisanUi.ProgressBar.Horizontal</item>
        <item name="smartisanCircularProgressBarStyle">@style/Widget.SmartisanUi.ProgressBar.Circular.Medium</item>
        <item name="smartisanSpinnerStyle">@style/Widget.SmartisanUi.Spinner</item>
    </style>
</resources>
