<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Public-SDK adapter theme hooks. Keep names prefixed to avoid app/theme collisions. -->
    <attr name="smartisanCheckBoxStyle" format="reference" />
    <attr name="smartisanRadioButtonStyle" format="reference" />
    <attr name="smartisanProgressBarStyle" format="reference" />
    <attr name="smartisanCircularProgressBarStyle" format="reference" />
    <attr name="smartisanSpinnerStyle" format="reference" />
    <attr name="smartisanBottomSheetDialogTheme" format="reference" />

    <attr name="cornerRadius" format="dimension" />
    <attr name="buttonStyle" format="integer">
        <enum name="normal" value="0" />
        <enum name="back" value="1" />
        <enum name="setting" value="2" />
        <enum name="delete" value="3" />
        <enum name="highlightBlue" value="4" />
        <enum name="highlightRed" value="5" />
        <enum name="normalWithIcon" value="6" />
        <enum name="areaOnlyIcon" value="7" />
        <enum name="search" value="8" />
        <enum name="customBackground" value="9" />
        <enum name="mix" value="10" />
    </attr>
    <attr name="buttonSrc" format="reference" />
    <declare-styleable name="SmartisanButton">
        <attr name="buttonStyle" />
        <attr name="buttonSrc" />
    </declare-styleable>

    <attr name="shadow_enabled" format="boolean" />
    <attr name="shadow_project" format="boolean" />
    <attr name="backgroundShadow" format="reference" />
    <attr name="shadowButtonStyle" format="integer">
        <enum name="smallButton" value="1" />
        <enum name="longButton" value="2" />
        <enum name="shrinkLongButton" value="3" />
    </attr>
    <attr name="shadowColors" format="color|reference" />
    <declare-styleable name="SmartisanShadowButton">
        <attr name="android:shadowDx" />
        <attr name="android:shadowDy" />
        <attr name="android:shadowRadius" />
        <attr name="shadow_enabled" />
        <attr name="shadow_project" />
        <attr name="backgroundShadow" />
        <attr name="shadowButtonStyle" />
        <attr name="shadowColors" />
    </declare-styleable>

    <attr name="title" format="string" />
    <attr name="summary" format="string" />
    <attr name="icon" format="reference" />
    <attr name="customMidView" format="reference" />
    <attr name="customRightView" format="reference" />
    <attr name="isPressable" format="boolean" />
    <attr name="backgroundStyle">
        <enum name="single" value="1" />
        <enum name="top" value="2" />
        <enum name="middle" value="3" />
        <enum name="bottom" value="4" />
    </attr>
    <attr name="selectedIcon" format="reference" />
    <attr name="isChecked" format="boolean" />
    <attr name="subTitle" format="string" />
    <attr name="show_arrow" format="boolean" />
    <declare-styleable name="SmartisanListContentItem">
        <attr name="title" />
        <attr name="summary" />
        <attr name="icon" />
        <attr name="shadow_enabled" />
        <attr name="shadow_project" />
        <attr name="customMidView" />
        <attr name="customRightView" />
        <attr name="isPressable" />
        <attr name="backgroundStyle" />
    </declare-styleable>
    <declare-styleable name="SmartisanListContentItemText">
        <attr name="subTitle" />
        <attr name="show_arrow" />
    </declare-styleable>
    <declare-styleable name="SmartisanListContentItemSwitch">
        <attr name="isChecked" />
    </declare-styleable>
    <declare-styleable name="SmartisanListContentItemCheck">
        <attr name="selectedIcon" />
    </declare-styleable>
    <attr name="titleBarCenterText" format="string|reference" />
    <attr name="titleBarBottomType" format="boolean" />
    <declare-styleable name="SmartisanTitleBar">
        <attr name="titleBarCenterText" />
        <attr name="titleBarBottomType" />
    </declare-styleable>

    <attr name="editorHint" format="string|reference" />
    <attr name="editorSingleLine" format="boolean" />
    <attr name="editorType">
        <enum name="defaultEditor" value="0" />
        <enum name="passwordEditor" value="1" />
        <enum name="quickDeleteEditor" value="2" />
    </attr>
    <attr name="editorEditable" format="boolean" />
    <declare-styleable name="SmartisanEditor">
        <attr name="editorHint" />
        <attr name="editorSingleLine" />
        <attr name="editorType" />
        <attr name="editorEditable" />
        <attr name="backgroundStyle" />
    </declare-styleable>

    <attr name="leftIcon" format="reference" />
    <attr name="rightIcon" format="reference" />
    <attr name="leftLabel" format="string|reference" />
    <attr name="rightLabel" format="string|reference" />
    <attr name="showLeftArrow" format="boolean" />
    <attr name="showRightDivider" format="boolean" />
    <declare-styleable name="SmartisanLabelEditor">
        <attr name="leftIcon" />
        <attr name="rightIcon" />
        <attr name="leftLabel" />
        <attr name="rightLabel" />
        <attr name="showLeftArrow" />
        <attr name="showRightDivider" />
    </declare-styleable>
    <attr name="bottomBarIconArray" format="reference" />
    <attr name="bottomBarIconShowBackgroundMode" format="boolean" />
    <declare-styleable name="SmartisanIconBottomBar">
        <attr name="bottomBarIconArray" />
        <attr name="bottomBarIconShowBackgroundMode" />
    </declare-styleable>
    <attr name="leftButtonBackground" format="color|reference" />
    <attr name="centerButtonBackground" format="color|reference" />
    <attr name="rightButtonBackground" format="color|reference" />
    <declare-styleable name="SmartisanMixBottomBar">
        <attr name="leftButtonBackground" />
        <attr name="centerButtonBackground" />
        <attr name="rightButtonBackground" />
    </declare-styleable>
    <attr name="buttonCount" format="integer" />
    <attr name="hasButtonGap" format="boolean" />
    <attr name="supportLayout" format="boolean" />
    <declare-styleable name="SmartisanButtonGroup">
        <attr name="buttonCount" />
        <attr name="hasButtonGap" />
        <attr name="supportLayout" />
    </declare-styleable>
    <attr name="actionType">
        <enum name="left" value="0" />
        <enum name="both" value="1" />
    </attr>
    <declare-styleable name="SmartisanActionButtonGroup">
        <attr name="actionType" />
        <attr name="supportLayout" />
    </declare-styleable>
    <attr name="sliderProgressDrawable" format="reference" />
    <attr name="sliderThumb" format="reference" />
    <attr name="sliderLeftIcon" format="reference" />
    <attr name="sliderRightIcon" format="reference" />
    <declare-styleable name="SmartisanSliderWithIcons">
        <attr name="sliderProgressDrawable" />
        <attr name="sliderThumb" />
        <attr name="sliderLeftIcon" />
        <attr name="sliderRightIcon" />
    </declare-styleable>
    <attr name="foreRingWidth" format="dimension" />
    <attr name="backRingWidth" format="dimension" />
    <attr name="downloadProgress" format="integer" />
    <attr name="backProgressStartColor" format="color" />
    <attr name="backProgressEndColor" format="color" />
    <attr name="foreProgressStartColor" format="color" />
    <attr name="foreProgressEndColor" format="color" />
    <attr name="innerCircleRadius" format="dimension" />
    <attr name="failedProgressColor" format="color" />
    <declare-styleable name="SmartisanDownloadProgressView">
        <attr name="foreRingWidth" />
        <attr name="backRingWidth" />
        <attr name="downloadProgress" />
        <attr name="backProgressStartColor" />
        <attr name="backProgressEndColor" />
        <attr name="foreProgressStartColor" />
        <attr name="foreProgressEndColor" />
        <attr name="innerCircleRadius" />
        <attr name="failedProgressColor" />
    </declare-styleable>
</resources>
