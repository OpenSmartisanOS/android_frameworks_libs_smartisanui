<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="buttonStyle" format="integer">
        <enum name="normal" value="0" />
        <enum name="back" value="1" />
        <enum name="setting" value="2" />
        <enum name="delete" value="3" />
        <enum name="highlightBlue" value="4" />
        <enum name="highlightRed" value="5" />
        <enum name="normalWithIcon" value="6" />
        <enum name="areaOnlyIcon" value="7" />
        <enum name="search" value="8" />
        <enum name="customBackground" value="9" />
        <enum name="mix" value="10" />
    </attr>
    <attr name="buttonSrc" format="reference" />
    <declare-styleable name="SmartisanButton">
        <attr name="buttonStyle" />
        <attr name="buttonSrc" />
    </declare-styleable>

    <attr name="shadow_enabled" format="boolean" />
    <attr name="shadow_project" format="boolean" />
    <attr name="backgroundShadow" format="reference" />
    <attr name="shadowButtonStyle" format="integer">
        <enum name="smallButton" value="1" />
        <enum name="longButton" value="2" />
        <enum name="shrinkLongButton" value="3" />
    </attr>
    <attr name="shadowColors" format="color|reference" />
    <declare-styleable name="SmartisanShadowButton">
        <attr name="android:shadowDx" />
        <attr name="android:shadowDy" />
        <attr name="android:shadowRadius" />
        <attr name="shadow_enabled" />
        <attr name="shadow_project" />
        <attr name="backgroundShadow" />
        <attr name="shadowButtonStyle" />
        <attr name="shadowColors" />
    </declare-styleable>

    <attr name="title" format="string" />
    <attr name="summary" format="string" />
    <attr name="icon" format="reference" />
    <attr name="customMidView" format="reference" />
    <attr name="customRightView" format="reference" />
    <attr name="isPressable" format="boolean" />
    <attr name="backgroundStyle">
        <enum name="single" value="1" />
        <enum name="top" value="2" />
        <enum name="middle" value="3" />
        <enum name="bottom" value="4" />
    </attr>
    <attr name="selectedIcon" format="reference" />
    <attr name="isChecked" format="boolean" />
    <attr name="subTitle" format="string" />
    <attr name="show_arrow" format="boolean" />
    <declare-styleable name="SmartisanListContentItem">
        <attr name="title" />
        <attr name="summary" />
        <attr name="icon" />
        <attr name="shadow_enabled" />
        <attr name="shadow_project" />
        <attr name="customMidView" />
        <attr name="customRightView" />
        <attr name="isPressable" />
        <attr name="backgroundStyle" />
    </declare-styleable>
    <declare-styleable name="SmartisanListContentItemText">
        <attr name="subTitle" />
        <attr name="show_arrow" />
    </declare-styleable>
    <declare-styleable name="SmartisanListContentItemSwitch">
        <attr name="isChecked" />
    </declare-styleable>
    <declare-styleable name="SmartisanListContentItemCheck">
        <attr name="selectedIcon" />
    </declare-styleable>
    <attr name="titleBarCenterText" format="string|reference" />
    <attr name="titleBarBottomType" format="boolean" />
    <declare-styleable name="SmartisanTitleBar">
        <attr name="titleBarCenterText" />
        <attr name="titleBarBottomType" />
    </declare-styleable>
</resources>
