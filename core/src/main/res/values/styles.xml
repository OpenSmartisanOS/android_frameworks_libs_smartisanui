<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartisanUi" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/smartisan_catalog_background</item>
        <item name="smartisanCheckBoxStyle">@style/Widget.SmartisanUi.CheckBox</item>
        <item name="smartisanRadioButtonStyle">@style/Widget.SmartisanUi.RadioButton</item>
        <item name="smartisanProgressBarStyle">@style/Widget.SmartisanUi.ProgressBar.Horizontal</item>
        <item name="smartisanCircularProgressBarStyle">@style/Widget.SmartisanUi.ProgressBar.Circular.Medium</item>
        <item name="smartisanSpinnerStyle">@style/Widget.SmartisanUi.Spinner</item>
    </style>
    <style name="Theme.SmartisanUi.AlertDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartisanUi.Dialog</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:windowMinWidthMajor">@dimen/smartisan_rom_alert_dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@dimen/smartisan_rom_alert_dialog_min_width_minor</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="Animation.SmartisanUi.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/smartisan_rom_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/smartisan_rom_dialog_exit</item>
    </style>

    <style name="Theme.SmartisanUi.ExternalMenuDialog"
        parent="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartisanUi.Dialog</item>
    </style>

    <style name="Theme.SmartisanUi.ProgressDialog"
        parent="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartisanUi.Dialog</item>
    </style>

    <style name="Theme.SmartisanUi.MenuDialog" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
    </style>

    <style name="Theme.SmartisanUi.PickerDialog" parent="Theme.SmartisanUi.MenuDialog" />

    <style name="Widget.SmartisanUi.AlertDialog.Button" parent="@android:style/Widget.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">@dimen/smartisan_rom_alert_dialog_button_bar_height</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SmartisanUi.ShadowButton" parent="@android:style/Widget.Material.Button" />

    <style name="Widget.SmartisanUi.CheckBox"
        parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/smartisan_rom_selector_check_box</item>
        <item name="android:buttonTint">@null</item>
    </style>

    <style name="Widget.SmartisanUi.RadioButton"
        parent="@android:style/Widget.CompoundButton.RadioButton">
        <item name="android:button">@drawable/smartisan_rom_selector_radio_choice</item>
        <item name="android:buttonTint">@null</item>
    </style>

    <style name="Widget.SmartisanUi.ProgressBar.Horizontal"
        parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/smartisan_rom_progress_horizontal</item>
        <item name="android:indeterminateDrawable">@drawable/smartisan_rom_progress_indeterminate_horizontal</item>
        <item name="android:progressTint">@null</item>
        <item name="android:secondaryProgressTint">@null</item>
        <item name="android:progressBackgroundTint">@null</item>
        <item name="android:indeterminateTint">@null</item>
        <item name="android:minHeight">16dp</item>
    </style>

    <style name="Widget.SmartisanUi.ProgressBar.Circular"
        parent="@android:style/Widget.ProgressBar">
        <item name="android:indeterminateOnly">true</item>
        <item name="android:indeterminateDuration">3500</item>
        <item name="android:indeterminateBehavior">repeat</item>
        <item name="android:indeterminateDrawable">@drawable/smartisan_rom_progress_medium_smartisanos_light</item>
        <item name="android:indeterminateTint">@null</item>
    </style>

    <style name="Widget.SmartisanUi.ProgressBar.Circular.Small"
        parent="Widget.SmartisanUi.ProgressBar.Circular">
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:maxWidth">32dp</item>
        <item name="android:maxHeight">32dp</item>
    </style>

    <style name="Widget.SmartisanUi.ProgressBar.Circular.Medium"
        parent="Widget.SmartisanUi.ProgressBar.Circular">
        <item name="android:maxWidth">48dp</item>
        <item name="android:maxHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.SmartisanUi.ProgressBar.Circular.Large"
        parent="Widget.SmartisanUi.ProgressBar.Circular">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:maxWidth">64dp</item>
        <item name="android:maxHeight">64dp</item>
    </style>

    <!-- Kept as an alias for existing XML callers. -->
    <style name="SmartisanProgressBarCircleStyle.Medium"
        parent="Widget.SmartisanUi.ProgressBar.Circular.Medium" />

    <style name="Widget.SmartisanUi.Spinner" parent="@android:style/Widget.Spinner">
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:background">@drawable/smartisan_rom_editor_bg_single</item>
        <item name="android:popupBackground">@drawable/smartisan_rom_pop_up_menu_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Animation.SmartisanUi.Popup.Below" parent="">
        <item name="android:windowEnterAnimation">@anim/smartisan_rom_popup_grow_fade_in</item>
        <item name="android:windowExitAnimation">@anim/smartisan_rom_popup_shrink_fade_out</item>
    </style>
    <style name="Animation.SmartisanUi.Popup.Above" parent="">
        <item name="android:windowEnterAnimation">@anim/smartisan_rom_popup_grow_fade_in_from_bottom</item>
        <item name="android:windowExitAnimation">@anim/smartisan_rom_popup_shrink_fade_out_from_bottom</item>
    </style>
    <style name="Animation.SmartisanUi.Popup.FromLeft" parent="Animation.SmartisanUi.Popup.Below" />
    <style name="Animation.SmartisanUi.Popup.FromRight" parent="Animation.SmartisanUi.Popup.Below" />
    <style name="Animation.SmartisanUi.BottomMenu" parent="">
        <item name="android:windowEnterAnimation">@anim/smartisan_bottom_menu_in</item>
        <item name="android:windowExitAnimation">@anim/smartisan_bottom_menu_out</item>
    </style>

    <style name="smartisan_rom_PopupMenuStyle">
        <item name="android:background">@drawable/smartisan_rom_pop_up_menu_bg</item>
    </style>

    <style name="Widget.SmartisanUi.ShadowButton.Small" parent="Widget.SmartisanUi.ShadowButton">
        <item name="android:textSize">@dimen/smartisan_button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="shadowButtonStyle">smallButton</item>
    </style>
    <style name="Widget.SmartisanUi.ShadowButton.Long">
        <item name="android:textSize">@dimen/smartisan_shadow_button_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/smartisan_button_highlight_text_color</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">-2</item>
        <item name="android:shadowRadius">0.1</item>
        <item name="shadowButtonStyle">longButton</item>
        <item name="shadowColors">@color/smartisan_button_text_shadow_color</item>
    </style>
    <style name="Widget.SmartisanUi.ShadowButton.Shrink" parent="Widget.SmartisanUi.ShadowButton.Long">
        <item name="shadowButtonStyle">shrinkLongButton</item>
    </style>

    <style name="smartisan_rom_ListContentItemPrimaryText">
        <item name="android:textColor">@color/smartisan_rom_setting_item_text_colorlist</item>
        <item name="android:ellipsize">end</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="smartisan_rom_ListContentItemSecondaryText">
        <item name="android:textColor">@color/smartisan_rom_setting_item_summary_text_colorlist</item>
        <item name="android:ellipsize">end</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="smartisan_rom_EditorLabelTextStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/smartisan_rom_editor_label_text_color</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="smartisan_rom_EditorTextStyle">
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/smartisan_rom_editor_text_color</item>
        <item name="android:textColorHint">@color/smartisan_rom_editor_hint_text_color</item>
        <item name="android:background">@null</item>
        <item name="android:layout_marginLeft">@dimen/smartisan_rom_editor_horizontal_margin</item>
        <item name="android:layout_marginTop">@dimen/smartisan_rom_editor_small_vertical_margin</item>
        <item name="android:layout_marginRight">@dimen/smartisan_rom_editor_horizontal_margin</item>
        <item name="android:layout_marginBottom">@dimen/smartisan_rom_editor_small_vertical_margin</item>
    </style>
    <style name="smartisan_rom_SeekBarStyle.Thin.LargeThumb.Actived" parent="@android:style/Widget.Material.SeekBar">
        <item name="android:thumb">@drawable/smartisan_rom_seekbar_scrubber_control_selector</item>
        <item name="android:progressDrawable">@drawable/smartisan_rom_thin_progress_horizontal_drawable</item>
        <item name="android:splitTrack">false</item>
    </style>
    <style name="smartisan_rom_SnackbarMessageStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#996b3d</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginLeft">18dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginRight">18dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Remapped from framework-smartisanos-res.apk's TipsViewAppearance. -->
    <style name="SmartisanTipsBarAppearance">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">#80000000</item>
        <item name="android:paddingLeft">30dp</item>
        <item name="android:paddingRight">30dp</item>
        <item name="android:shadowColor">#2dffffff</item>
        <item name="android:shadowDy">2.0</item>
        <item name="android:shadowRadius">0.1</item>
    </style>
</resources>
