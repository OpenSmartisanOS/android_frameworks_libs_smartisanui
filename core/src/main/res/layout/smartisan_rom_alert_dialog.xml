<?xml version="1.0" encoding="utf-8"?>
<!--
  Direct namespace remap of framework-res.apk/res/layout/alert_dialog_smartisanos.xml.
  The framework-only title widget is replaced by the public TextView class.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/smartisan_rom_alert_parent_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@id/smartisan_rom_alert_top_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@id/smartisan_rom_alert_title_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:minHeight="@dimen/smartisan_rom_alert_dialog_title_height"
            android:orientation="horizontal">

            <ImageView
                android:id="@id/smartisan_rom_alert_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:src="@null"
                android:visibility="gone" />

            <TextView
                android:id="@id/smartisan_rom_alert_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/smartisan_rom_dialog_title_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@id/smartisan_rom_alert_content_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:id="@id/smartisan_rom_alert_scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipToPadding="false">

            <TextView
                android:id="@id/smartisan_rom_alert_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="96dp"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:gravity="start|center_vertical"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/smartisan_rom_dialog_secondary_text"
                android:textSize="15sp" />
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@id/smartisan_rom_alert_custom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <FrameLayout
            android:id="@id/smartisan_rom_alert_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <LinearLayout
        android:id="@id/smartisan_rom_alert_button_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/smartisan_rom_alert_dialog_button_bar_height"
        android:orientation="vertical"
        android:tag="smartisanos">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:baselineAligned="false"
            android:divider="@drawable/smartisan_rom_dialog_button_divider"
            android:layoutDirection="locale"
            android:orientation="horizontal"
            android:showDividers="middle">

            <Button
                android:id="@id/smartisan_rom_alert_button_negative"
                style="@style/Widget.SmartisanUi.AlertDialog.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="@dimen/smartisan_rom_alert_dialog_button_bar_height"
                android:textAllCaps="false"
                android:textSize="13.5dp"
                android:textStyle="bold" />

            <Button
                android:id="@id/smartisan_rom_alert_button_neutral"
                style="@style/Widget.SmartisanUi.AlertDialog.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="@dimen/smartisan_rom_alert_dialog_button_bar_height"
                android:textAllCaps="false"
                android:textSize="13.5dp"
                android:textStyle="bold" />

            <Button
                android:id="@id/smartisan_rom_alert_button_positive"
                style="@style/Widget.SmartisanUi.AlertDialog.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:minHeight="@dimen/smartisan_rom_alert_dialog_button_bar_height"
                android:textAllCaps="false"
                android:textSize="13.5dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
