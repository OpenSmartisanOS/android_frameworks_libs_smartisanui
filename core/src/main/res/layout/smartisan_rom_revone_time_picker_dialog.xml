<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical">

    <org.opensmartisanos.ui.widget.SmartisanDialogTitleBar
        android:id="@id/smartisan_rom_menu_dialog_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:smartisanShowDivider="false" />

    <LinearLayout
        android:id="@id/smartisan_rom_picker_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <org.opensmartisanos.ui.widget.SmartisanTimePicker
            android:id="@id/smartisan_rom_time_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/smartisan_rom_time_picker_widget_bottom" />
    </LinearLayout>
</LinearLayout>
