<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartisanUi.AlertDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartisanUi.Dialog</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:windowMinWidthMajor">@dimen/smartisan_rom_alert_dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@dimen/smartisan_rom_alert_dialog_min_width_minor</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="Theme.SmartisanUi.ProgressDialog"
        parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartisanUi.Dialog</item>
    </style>

    <style name="Widget.SmartisanUi.ProgressBar.Circular"
        parent="@android:style/Widget.ProgressBar">
        <item name="android:indeterminateOnly">true</item>
        <item name="android:indeterminateDuration">3500</item>
        <item name="android:indeterminateBehavior">repeat</item>
        <item name="android:indeterminateDrawable">@drawable/smartisan_rom_progress_medium_smartisanos_dark</item>
        <item name="android:indeterminateTint">@null</item>
    </style>
</resources>
